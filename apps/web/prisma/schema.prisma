// Sabzineh — Prisma schema (Week 1).
// PostgreSQL (Neon). Money is stored as integer Toman (never float).
// Commission is snapshotted on OrderItem.commissionRate at order time.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  VENDOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum VendorStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OrderStatus {
  PENDING
  PAID
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentProvider {
  MOCK
  ZARINPAL
}

enum WalletTxType {
  CREDIT
  DEBIT
}

enum DiscountType {
  PERCENT
  FIXED
}

enum PlanKind {
  VENDOR
  BOX
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
}

enum BoxDeliveryStatus {
  SCHEDULED
  SKIPPED
  DELIVERED
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
}

enum PayoutStatus {
  PENDING
  PAID
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum BannerPlacement {
  HOME_HERO
  HOME_STRIP
  CATEGORY
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  phone        String?
  name         String
  role         Role       @default(CUSTOMER)
  status       UserStatus @default(ACTIVE)
  passwordHash String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  vendorProfile VendorProfile?
  addresses     Address[]
  orders        Order[]
  wallet        Wallet?
  reviews       Review[]
  tickets       Ticket[]
  notifications Notification[]
  auditLogs     AuditLog[]
}

model VendorProfile {
  id        String       @id @default(cuid())
  userId    String       @unique
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopName  String
  slug      String       @unique
  city      String
  bio       String?
  status    VendorStatus @default(PENDING)
  rating    Float        @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  products Product[]
  payouts  Payout[]
}

model Category {
  id        String     @id @default(cuid())
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  slug      String     @unique
  nameFa    String
  nameEn    String
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())

  products Product[]
}

model Product {
  id             String        @id @default(cuid())
  vendorId       String
  vendor         VendorProfile @relation(fields: [vendorId], references: [id])
  categoryId     String
  category       Category      @relation(fields: [categoryId], references: [id])
  title          String
  slug           String        @unique
  description    String
  price          Int
  compareAtPrice Int?
  stock          Int           @default(0)
  status         ProductStatus @default(DRAFT)
  organic        Boolean       @default(false)
  glutenFree     Boolean       @default(false)
  local          Boolean       @default(false)
  attributes     Json?
  rating         Float         @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  images    ProductImage[]
  orderItems OrderItem[]
  reviews   Review[]

  @@index([categoryId, status, price])
  @@index([vendorId, status])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String
  sortOrder Int     @default(0)
  width     Int?
  height    Int?

  @@index([productId, sortOrder])
}

model Order {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id])
  status         OrderStatus @default(PENDING)
  total          Int
  discountId     String?
  discount       Discount?   @relation(fields: [discountId], references: [id])
  idempotencyKey String      @unique
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  items    OrderItem[]
  payments Payment[]

  @@index([userId, createdAt])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product @relation(fields: [productId], references: [id])
  vendorId       String
  qty            Int
  unitPrice      Int
  // Snapshot: a later plan change never rewrites payout history.
  commissionRate Float

  @@index([orderId])
  @@index([vendorId])
}

model Payment {
  id        String          @id @default(cuid())
  orderId   String
  order     Order           @relation(fields: [orderId], references: [id])
  provider  PaymentProvider
  authority String?         @unique
  amount    Int
  status    PaymentStatus   @default(PENDING)
  refId     String?
  createdAt DateTime        @default(now())
}

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions WalletTransaction[]
}

model WalletTransaction {
  id        String       @id @default(cuid())
  walletId  String
  wallet    Wallet       @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type      WalletTxType
  amount    Int
  refType   String
  refId     String
  createdAt DateTime     @default(now())

  @@index([walletId, createdAt])
}

model Discount {
  id          String       @id @default(cuid())
  code        String       @unique
  type        DiscountType
  value       Int
  minAmount   Int          @default(0)
  usageLimit  Int?
  usedCount   Int          @default(0)
  expiresAt   DateTime?
  createdAt   DateTime     @default(now())

  orders Order[]
}

model Plan {
  id          String   @id @default(cuid())
  kind        PlanKind
  title       String
  price       Int
  periodDays  Int
  features    Json
  createdAt   DateTime @default(now())

  subscriptions Subscription[]
}

model Subscription {
  id               String             @id @default(cuid())
  userId           String
  planId           String
  plan             Plan               @relation(fields: [planId], references: [id])
  status           SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd DateTime
  autoRenew        Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  boxDeliveries BoxDelivery[]
  invoices      Invoice[]

  @@index([userId, status])
}

model BoxDelivery {
  id             String            @id @default(cuid())
  subscriptionId String
  subscription   Subscription      @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  weekStart      DateTime
  status         BoxDeliveryStatus @default(SCHEDULED)
  createdAt      DateTime          @default(now())

  @@index([subscriptionId, weekStart])
}

model Invoice {
  id             String        @id @default(cuid())
  subscriptionId String
  subscription   Subscription  @relation(fields: [subscriptionId], references: [id])
  amount         Int
  status         InvoiceStatus @default(PENDING)
  paidAt         DateTime?
  paymentId      String?
  createdAt      DateTime      @default(now())
}

model Payout {
  id          String       @id @default(cuid())
  vendorId    String
  vendor      VendorProfile @relation(fields: [vendorId], references: [id])
  periodStart DateTime
  periodEnd   DateTime
  gross       Int
  commission  Int
  net         Int
  status      PayoutStatus @default(PENDING)
  createdAt   DateTime     @default(now())

  @@index([vendorId, periodStart])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  city       String
  text       String
  postalCode String
  phone      String
  createdAt  DateTime @default(now())
}

model Review {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  productId String
  product   Product      @relation(fields: [productId], references: [id])
  rating    Int
  text      String
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now())

  @@unique([userId, productId])
}

model Ticket {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  subject   String
  status    TicketStatus @default(OPEN)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  messages TicketMessage[]
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId  String
  text      String
  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

model Banner {
  id         String          @id @default(cuid())
  title      String
  imageUrl   String
  linkUrl    String?
  placement  BannerPlacement
  startsAt   DateTime?
  endsAt     DateTime?
  active     Boolean         @default(true)
  createdAt  DateTime        @default(now())

  @@index([placement, active])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  payload   Json
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
}
