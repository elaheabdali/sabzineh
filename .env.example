# Neon Postgres (supply a real value before `prisma migrate dev` / `pnpm db:seed`).
DATABASE_URL="postgresql://user:password@host:5432/sabzineh?sslmode=require"
# Payment provider: "mock" (default) or "zarinpal" (sandbox until ZARINPAL_SANDBOX=false).
PAYMENT_PROVIDER="mock"
# Zarinpal sandbox merchant id (test UUID). Real merchant id only in Vercel, never in git.
ZARINPAL_MERCHANT_ID="00000000-0000-0000-0000-000000000000"
ZARINPAL_SANDBOX="true"
# AI provider (Week 7). The app works without it: AI features fall back to no-AI behaviour.
AI_API_KEY=""
AI_MODEL=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"
